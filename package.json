    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "30.1.3",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
